# ══════════════════════════════════════════════════════════════════════
# Security headers for techbird.in - one file, included everywhere
#
# Install:
#     sudo cp nginx-security-headers.conf.example /etc/nginx/snippets/techbird-security-headers.conf
# then, in nginx-techbird.conf.example's server block, `include` it ONCE at
# server level AND again inside every `location` that sets its own add_header
# (see the cache-header locations there).
#
# Why twice: nginx does NOT merge add_header across levels. As soon as a
# location block contains any add_header (even Cache-Control), it stops
# inheriting the server block's headers - so the images and assets served by
# those locations would silently lose every header below.
#
# Replace what is already there: this box currently sends X-Frame-Options,
# X-Content-Type-Options, Strict-Transport-Security and a Referrer-Policy from
# somewhere else. Delete those add_header lines when you include this file,
# or each header is sent twice - Referrer-Policy already is, and reaches the
# browser as "same-origin, strict-origin-when-cross-origin".
#
# Keep these values identical to the "/(.*)" block of vercel.json - run
# `npm run check:security` after editing either one.
# ══════════════════════════════════════════════════════════════════════

add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()" always;

# What each allowance is for - everything not listed here is blocked:
#   script-src   own scripts, plus Cloudflare Turnstile on the contact form
#   style-src    'unsafe-inline': index.html carries the @font-face rules inline
#                and the prerendered pages carry style="" attributes
#   img-src      own images, plus data: URIs used for CSS background patterns
#   connect-src  the contact form posts to Mailbird (or to /mailbird via 'self');
#                Turnstile talks to challenges.cloudflare.com
#   frame-src    the Turnstile widget and the click-to-load Google map
#   frame-ancestors 'self'  supersedes X-Frame-Options in current browsers
# JSON-LD <script type="application/ld+json"> blocks are data, not executed,
# so script-src does not apply to them.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://mailbird.techbird.in https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" always;
